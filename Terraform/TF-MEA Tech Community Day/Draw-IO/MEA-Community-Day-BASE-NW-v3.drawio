    <diagram id="WVpeS4PPq6Ohgr1VNbgj" name="Tips and Tricks - Tools">
        <mxGraphModel dx="2121" dy="858" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="Jn36fnZ3ozxFyv3xfRCP-1" value="&lt;b&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Utilities needed to be installed&lt;/font&gt;&lt;br&gt;&lt;/b&gt;&lt;br&gt;hping3&lt;br&gt;sudo apt install -y hping3&lt;br&gt;&lt;br&gt;Traceroute&lt;br&gt;sudo apt install inetutils-traceroute&lt;br&gt;&lt;br&gt;Apache&lt;br&gt;&lt;br&gt;# SETTING UP WEB SERVERS&lt;br&gt;sudo apt-get update -y&lt;br&gt;sudo apt-get install apache2 -y&lt;br&gt;&lt;br&gt;Psping&lt;br&gt;&lt;br&gt;PsPing - Sysinternals | Microsoft Learn (copy unzipped files into Syetem32)" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="290" y="80" width="650" height="420" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;p style=&quot;margin: 0in;&quot; lang=&quot;en-ZA&quot;&gt;&lt;span style=&quot;font-weight: bold; text-decoration: underline;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Test access to a WWW&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;p style=&quot;margin:0in;font-family:Calibri;font-size:16.0pt&quot; lang=&quot;en-ZA&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Comic Sans MS&amp;quot;; font-size: 16pt; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: bold; text-decoration-line: underline;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0in;font-family:Calibri;font-size:16.0pt&quot; lang=&quot;en-ZA&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Comic Sans MS&amp;quot;; font-size: 16pt; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: bold; text-decoration-line: underline;&quot;&gt;Check ,my Public IP &lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Comic Sans MS&amp;quot;; font-size: 16pt; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-decoration-line: underline;&quot;&gt;Every 2 seconds ….&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;br&gt;&lt;p style=&quot;margin: 0in; font-size: 16pt;&quot; lang=&quot;en-ZA&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;watch -n 2 curl ifconfig.io&lt;/font&gt;&lt;/p&gt;&lt;br&gt;&lt;br&gt;&lt;p style=&quot;margin: 0in; font-size: 20pt;&quot; lang=&quot;en-ZA&quot;&gt;&lt;span style=&quot;font-weight: bold;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;watch curl ifconfig.io&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0in;font-family:&amp;quot;Calibri Light&amp;quot;;font-size:20.0pt&quot; lang=&quot;en-ZA&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0in; font-size: 16pt;&quot; lang=&quot;en-ZA&quot;&gt;curl -iv --raw &lt;a href=&quot;https://www.bing.com&quot;&gt;https://www.bing.com&lt;/a&gt;&lt;/p&gt;&lt;br&gt;&lt;br&gt;&lt;p style=&quot;margin: 0in; font-size: 16pt;&quot; lang=&quot;en-ZA&quot;&gt;wget &lt;a href=&quot;http://www.bing.com&quot;&gt;http://www.bing.com&lt;/a&gt;&lt;/p&gt;&lt;br&gt;&lt;br&gt;&lt;p style=&quot;margin: 0in; font-size: 16pt;&quot; lang=&quot;en-ZA&quot;&gt;wget &lt;a href=&quot;http://www.bing.com&quot;&gt;www.bing.com&lt;/a&gt;&lt;/p&gt;" link="&lt;p style=&quot;margin:0in;font-family:&amp;quot;Calibri Light&amp;quot;;font-size:20.0pt&quot; lang=&quot;en-ZA&quot;&gt;&lt;span style=&quot;font-weight:bold;text-decoration:underline&quot;&gt;Test access to a WWW&lt;/span&gt;&lt;/p&gt;&#xa;&#xa;&lt;p style=&quot;margin:0in;font-family:Calibri;font-size:16.0pt&quot; lang=&quot;en-ZA&quot;&gt;curl -iv&#xa;--raw &lt;a href=&quot;https://www.bing.com&quot;&gt;https://www.bing.com&lt;/a&gt;&lt;/p&gt;&#xa;&#xa;&lt;p style=&quot;margin:0in;font-family:Calibri;font-size:16.0pt&quot; lang=&quot;en-ZA&quot;&gt;wget &lt;a href=&quot;http://www.bing.com&quot;&gt;http://www.bing.com&lt;/a&gt;&lt;/p&gt;&#xa;&#xa;&lt;p style=&quot;margin:0in;font-family:Calibri;font-size:16.0pt&quot; lang=&quot;en-ZA&quot;&gt;wget &lt;a href=&quot;http://www.bing.com&quot;&gt;www.bing.com&lt;/a&gt;&lt;/p&gt;" id="YJiPWFCKD7wX-O-GAN2b-1">
                    <mxCell style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" parent="1" vertex="1">
                        <mxGeometry x="1820" y="66" width="790" height="470" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="YJiPWFCKD7wX-O-GAN2b-2" value="&lt;div&gt;&lt;b&gt;&lt;u&gt;Using TCPDUMP&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;u&gt;&lt;br&gt;&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;u&gt;&lt;br&gt;&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;b&gt;How to see who is Pinging the host&lt;br&gt;&lt;/b&gt;sudo tcpdump -ni eth0 icmp&lt;br&gt;&lt;br&gt;&lt;b&gt;How to see only traffic from 1 IP  who is Pinging the host&lt;br&gt;&lt;/b&gt;sudo tcpdump -ni eth0 icmp and host 172.21.1.33&lt;br&gt;&lt;br&gt;&lt;b&gt;How to see only traffic from 1 IP range who is Pinging the host&lt;br&gt;&lt;/b&gt;sudo tcpdump -ni eth0 icmp and host 172.21.1.4&lt;br&gt;&lt;br&gt;&lt;b&gt;How to see only traffic from 1 IP range who is Pinging the host&lt;br&gt;&lt;/b&gt;sudo tcpdump -ni eth0 icmp and net 192.168.4.0/24 -c 10&lt;br&gt;&lt;br&gt;&lt;b&gt;How to see only traffic from ANY IP on port 22&lt;br&gt;&lt;/b&gt;sudo tcpdump -i any src port 22&lt;br&gt; tcpdump -ni eth0 port 22 and net 192.168.1.0/24&lt;br&gt; tcpdump -ni eth0 port 22 and host 192.168.1.4" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="460" width="560" height="250" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b&gt;&lt;u&gt;Install hping3&lt;br&gt;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;sudo apt install -y hping3&lt;br&gt;When installation is finished, we can check hping3 version:&lt;br&gt;&lt;br&gt;hping3 --version&lt;br&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;&lt;u&gt;Testing hping3&lt;br&gt;&lt;/u&gt;&lt;/b&gt;Now we can test. Let&#39;s say we want to check whether port 443 is open and calculate the round-trip time (RTT). Run the following command to do that:&lt;br&gt;&lt;br&gt;To do a normal ICMP Ping&lt;br&gt;sudo hping3 -1 8.8.8.8&lt;br&gt;&lt;br&gt;To ping to a IP addi and specific Port&lt;br&gt;sudo hping3 -S -p 22 za-east.fortiddns.com&lt;br&gt;sudo hping3 --icmp -c 10 bing.com&lt;br&gt;sudo hping3 -S -p 22 --beep za-east.fortiddns.com&lt;br&gt;sudo hping3 --icmp -c 10 --beep -i 2 www.bing.com&lt;/div&gt;" link="Install hping3&#xa;&#xa;sudo apt install -y hping3&#xa;When installation is finished, we can check hping3 version:&#xa;&#xa;1&#xa;hping3 --version&#xa;Testing hping3&#xa;Now we can test. Let&#39;s say we want to check whether port 443 is open and calculate the round-trip time (RTT). Run the following command to do that:&#xa;&#xa;Examples&#xa;&#xa;To do a normal ICMP Ping&#xa;sudo hping3 -1 8.8.8.8&#xa;&#xa;To ping to a IP addi and specific Port&#xa;sudo hping3 -S -p 22 za-east.fortiddns.com&#xa;sudo hping3 --icmp -c 10 bing.com&#xa;sudo hping3 -S -p 22 --beep za-east.fortiddns.com&#xa;sudo hping3 --icmp -c 10 --beep -i 2 www.bing.com" id="YJiPWFCKD7wX-O-GAN2b-3">
                    <mxCell style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=16;" parent="1" vertex="1">
                        <mxGeometry x="1070" y="30" width="560" height="330" as="geometry"/>
                    </mxCell>
                </UserObject>
            </root>
        </mxGraphModel>
    </diagram>
